<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="randommapgen" class="ru.mipt.bit.platformer.core.mapgenerator.RandomMapGenerator">
        <constructor-arg index="0" value="${ranmapg.width}"/>
        <constructor-arg index="1" value="${ranmapg.height}"/>
        <constructor-arg index="2" value="${ranmapg.treesn}"/>
        <constructor-arg index="3" value="${ranmapg.tann}"/>
    </bean>
</beans>